#!/usr/bin/env bash
# Resolves the kit through any symlink (it is linked into ~/.local/bin), then
# runs the CLI with the kit's own tsx and node_modules.
set -euo pipefail
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ $src != /* ]] && src="$dir/$src"
done
KIT="$(cd -P "$(dirname "$src")/.." && pwd)"
# tsx caches compiled files in the temp directory; full, it dies with a Node stack trace before the
# kit's own code can say what is wrong.
tmp="${TMPDIR:-/tmp}"
if probe=$(mktemp -d "${tmp%/}/sandcastle-probe.XXXXXX" 2>/dev/null); then rmdir "$probe"; else
  echo "sandcastle: cannot write to the temp directory ($tmp) - its disk is full, or it is read-only. Free some space there, or point TMPDIR at a directory with room, then try again." >&2
  exit 1
fi
exec "$KIT/node_modules/.bin/tsx" "$KIT/src/cli.ts" "$@"
